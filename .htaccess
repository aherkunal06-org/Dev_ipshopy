# Enable Apache rewrite engine
RewriteEngine On
#
# Since OpenCart is in the root of dev.ipshopy.com, use:
RewriteBase /dev.ipshopy/

# Prevent directory listing
Options -Indexes

# Follow symlinks (some hosts may require this)
Options +FollowSymlinks

# Block access to sensitive files
<FilesMatch "(?i)((\.tpl|\.twig|\.ini|\.log|(?<!robots)\.txt))">
    Require all denied
    # For Apache 2.2 or older:
    # Order deny,allow
    # Deny from all
</FilesMatch>

# SEO URL rules
RewriteRule ^sitemap.xml$ index.php?route=extension/feed/google_sitemap [L]
RewriteRule ^googlebase.xml$ index.php?route=extension/feed/google_base [L]
RewriteRule ^system/storage/(.*) index.php?route=error/not_found [L]

# Redirect all requests to index.php for SEO URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(ico|gif|jpg|jpeg|png|svg|webp|js|css|woff|woff2|ttf|eot|otf|mp4|webm|ogg|mp3|wav)$ [NC]
RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]

# Optional server-side tweaks (uncomment if needed)
# php_flag register_globals off
# php_flag magic_quotes_gpc Off
# php_value upload_max_filesize 100M
# php_value post_max_size 100M
# php_value max_execution_time 200
# php_value max_input_time 200
# php_admin_value open_basedir none
